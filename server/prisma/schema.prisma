generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model analyticsevent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  meta      String   @default("{}") @db.LongText
  createdAt DateTime @default(now())
}

model campaign {
  id                String    @id @default(cuid())
  title             String
  description       String    @default("") @db.LongText
  companyName       String    @default("")
  companyLogoUrl    String    @default("")
  status            String    @default("DRAFT")
  creatorId         String
  startsAt          DateTime?
  endsAt            DateTime?
  winnerCount       Int       @default(1)
  lotteryMode       String    @default("SIMPLE")
  autoApprove       Boolean   @default(true)
  totalRewardPoints Int       @default(0)
  createdAt         DateTime  @default(now())
  drawnAt           DateTime?
  rewardCurrency    String    @default("POINT")
  rewardsConfig     String    @default("[]") @db.LongText
  rewardImageUrl    String    @default("")
  drawAt            DateTime?
  rewardDistMode    String    @default("COMBINED")
  creator           user      @relation(fields: [creatorId], references: [id], map: "Campaign_creatorId_fk")
  missions          mission[]
  winners           winner[]

  @@index([creatorId], map: "Campaign_creatorId_fkey")
}

model mission {
  id          String       @id @default(cuid())
  campaignId  String
  type        String
  title       String
  description String       @default("") @db.LongText
  sortOrder   Int          @default(0)
  config      String       @default("{}") @db.LongText
  createdAt   DateTime     @default(now())
  campaign    campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade, map: "Mission_campaignId_fk")
  submissions submission[]

  @@index([campaignId], map: "Mission_campaignId_fk")
}

model submission {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  status    String   @default("PENDING")
  payload   String   @default("{}") @db.LongText
  createdAt DateTime @default(now())
  mission   mission  @relation(fields: [missionId], references: [id], onDelete: Cascade, map: "Submission_missionId_fk")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Submission_userId_fkey")

  @@unique([userId, missionId], map: "Submission_userId_missionId_key")
  @@index([missionId], map: "Submission_missionId_fk")
}

model user {
  id                  String           @id @default(cuid())
  email               String           @unique(map: "User_email_key")
  passwordHash        String?
  role                String           @default("USER")
  blocked             Boolean          @default(false)
  pointBalance        Int              @default(0)
  usdtBalance         Float            @default(0)
  brlBalance          Float            @default(0)
  metaqBalance        Float            @default(0)
  couponBalance       Int              @default(0)
  country             String?
  locale              String?
  lastIp              String?
  birthYear           Int?
  walletAddress       String?
  nickname            String?
  avatarUrl           String?
  createdAt           DateTime         @default(now())
  birthDate           DateTime?
  gender              String?
  region              String?
  discordId           String?
  instagramHandle     String?
  telegramHandle      String?
  updatedAt           DateTime         @default(now()) @updatedAt
  youtubeHandle       String?
  discordHandle       String?
  youtubeAccessToken  String?          @db.LongText
  youtubeRefreshToken String?          @db.LongText
  youtubeTokenExpiry  BigInt?
  telegramId          String?
  campaigns           campaign[]
  chatMessages        chatmessage[]
  managerRequests     managerrequest[]
  submissions         submission[]
  winners             winner[]
}

model winner {
  id            String   @id @default(cuid())
  campaignId    String
  userId        String
  rank          Int
  points        Int      @default(0)
  createdAt     DateTime @default(now())
  currency      String   @default("POINT")
  rewardsConfig String   @default("[]") @db.LongText
  campaign      campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, map: "Winner_campaignId_fkey")
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Winner_userId_fk")

  @@unique([campaignId, userId], map: "Winner_campaignId_userId_key")
  @@index([userId], map: "Winner_userId_fk")
}

model chatmessage {
  id        String   @id @default(cuid())
  userId    String?
  sender    String
  text      String   @db.LongText
  locale    String   @default("ko")
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ChatMessage_userId_fk")

  @@index([userId], map: "ChatMessage_userId_fkey")
}

model managerrequest {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  email        String
  phone        String?
  businessType String
  message      String   @db.LongText
  userId       String
  status       String   @default("PENDING")
  adminNote    String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ManagerRequest_userId_fk")

  @@index([userId], map: "ManagerRequest_userId_fkey")
}
