generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model analyticsevent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  meta      String   @default("{}") @db.Text
  createdAt DateTime @default(now())
}

model campaign {
  id                String    @id @default(cuid())
  title             String
  description       String    @default("") @db.Text
  companyName       String    @default("")
  companyLogoUrl    String    @default("")
  rewardImageUrl    String    @default("")
  status            String    @default("DRAFT")
  creatorId         String
  startsAt          DateTime?
  endsAt            DateTime?
  drawAt            DateTime?
  winnerCount       Int       @default(1)
  lotteryMode       String    @default("SIMPLE")
  autoApprove       Boolean   @default(true)
  totalRewardPoints Int       @default(0)
  rewardCurrency    String    @default("POINT")
  rewardsConfig     String    @default("[]") @db.Text
  createdAt         DateTime  @default(now())
  drawnAt           DateTime?
  creator           user?     @relation(fields: [creatorId], references: [id], map: "Campaign_creatorId_fk")
  missions          mission[]
  winners           winner[]

  @@index([creatorId], map: "Campaign_creatorId_fkey")
}

model mission {
  id          String       @id @default(cuid())
  campaignId  String
  type        String
  title       String
  description String       @default("") @db.Text
  sortOrder   Int          @default(0)
  config      String       @default("{}") @db.Text
  createdAt   DateTime     @default(now())
  campaign    campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade, map: "Mission_campaignId_fk")
  submissions  submission[]

  @@index([campaignId], map: "Mission_campaignId_fkey")
}

model submission {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  status    String   @default("PENDING")
  payload   String   @default("{}") @db.Text
  createdAt DateTime @default(now())
  mission   mission  @relation(fields: [missionId], references: [id], onDelete: Cascade, map: "Submission_missionId_fk")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Submission_userId_fkey")

  @@unique([userId, missionId], map: "Submission_userId_missionId_key")
  @@index([missionId], map: "Submission_missionId_fkey")
}

model user {
  id            String       @id @default(cuid())
  email         String       @unique(map: "User_email_key")
  passwordHash  String?
  role          String       @default("USER")
  blocked       Boolean      @default(false)
  pointBalance  Int          @default(0)
  country       String?
  locale        String?
  lastIp        String?
  birthYear     Int?
  walletAddress String?
  nickname      String?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  birthDate     DateTime?
  gender        String?
  region        String?
  telegramHandle String?
  telegramId     String?
  discordId      String?
  discordHandle  String?
  youtubeHandle  String?
  youtubeAccessToken String? @db.Text
  youtubeRefreshToken String? @db.Text
  youtubeTokenExpiry BigInt?
  instagramHandle String?
  updatedAt     DateTime     @default(now()) @updatedAt
  submissions   submission[]
  campaigns     campaign[]
  winners       winner[]
  chatMessages  chatmessage[]
  managerRequests managerrequest[]
}

model winner {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  rank       Int
  points     Int      @default(0)
  currency   String   @default("POINT")
  rewardsConfig String   @default("[]") @db.Text
  createdAt  DateTime @default(now())
  campaign   campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, map: "Winner_campaignId_fkey")
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Winner_userId_fk")

  @@unique([campaignId, userId], map: "Winner_campaignId_userId_key")
  @@index([userId], map: "Winner_userId_fkey")
}

model chatmessage {
  id        String   @id @default(cuid())
  userId    String?
  sender    String   // "user" | "bot"
  text      String   @db.Text
  locale    String   @default("ko")
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ChatMessage_userId_fk")

  @@index([userId], map: "ChatMessage_userId_fkey")
}

model managerrequest {
  id          String   @id @default(cuid())
  companyName String                       // 회사명
  contactName String                       // 담당자명
  email       String                       // 연락처 이메일
  phone       String?                      // 연락처 전화번호
  businessType String                      // 업종
  message     String   @db.Text            // 캠페인 목적 및 설명
  userId      String                       // 가입된 유저의 ID (방안 A이므로 필수)
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote   String?  @db.Text            // 관리자 메모
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ManagerRequest_userId_fk")

  @@index([userId], map: "ManagerRequest_userId_fkey")
}
